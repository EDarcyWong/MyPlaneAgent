# AI Provider Configuration
# Choose one: openai, anthropic, deepseek, ollama
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DeepSeek Configuration
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# Ollama Configuration (local)
OLLAMA_MODEL=qwen2.5:14b

# Agent Configuration
AGENT_MAX_REPLAN_ATTEMPTS=2
AGENT_TEMPERATURE=0.2

# Search routing: AUTO infers a region from OS timezone/locale; query language is not location.
# Override for travel/VPN use: CN, KR, RU, GLOBAL.
MYPLANE_SEARCH_REGION=AUTO
